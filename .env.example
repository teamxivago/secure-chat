# ---------- core ----------
DATABASE_URL=postgres://veil:veil@localhost:5432/veil
REDIS_URL=redis://localhost:6379
APP_URL=https://veil.app
TRUSTED_ORIGINS=capacitor://localhost,https://localhost
CORS_ORIGINS=https://veil.app,capacitor://localhost,https://localhost
# Generate with: pnpm secrets
BETTER_AUTH_SECRET=
SEALED_SENDER_PRIVATE_KEY=
NEXT_PUBLIC_SEALED_SENDER_TRUST_ROOT=
DISCOVERY_OPRF_KEY=
SENDER_TAG_PEPPER=
MEDIA_URL_SECRET=
LINK_PROXY_SECRET=

# ---------- public service URLs (what clients connect to) ----------
PUBLIC_CHAT_WS_URL=https://chat.veil.app
PUBLIC_CALL_WS_URL=https://calls.veil.app
MEDIA_WORKER_URL=http://media-worker:4002
LINK_SCRAPER_URL=http://link-scraper:4003
CALL_SIGNALING_URL=http://call-signaling:4005
MEDIA_PUBLIC_ORIGIN=https://<account>.r2.cloudflarestorage.com

# ---------- auth providers ----------
SMS_PROVIDER=twilio-verify        # twilio-verify | twilio | msg91 | console (dev only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
EMAIL_PROVIDER=smtp               # smtp | console (dev only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Veil <no-reply@veil.app>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=app.veil.messenger
OTP_SENDS_PER_HOUR=5
OTP_VERIFIES_PER_5MIN=10
# DEV_EXPOSE_OTP=1                # test-only OTP readback endpoint; ignored in production

# ---------- media (Cloudflare R2) ----------
STORAGE_DRIVER=r2                 # r2 | local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=veil-media
# LOCAL_STORAGE_DIR=./.data/media  # local driver
# MEDIA_PUBLIC_URL=http://localhost:4002

# ---------- push ----------
FIREBASE_SERVICE_ACCOUNT_FILE=/secrets/firebase.json
APNS_KEY_FILE=/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.veil.messenger
APNS_PRODUCTION=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---------- calls ----------
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# or self-hosted coturn (use-auth-secret):
TURN_SECRET=
TURN_URLS=turn:turn.veil.app:3478?transport=udp,turns:turn.veil.app:5349?transport=tcp

# ---------- search / previews ----------
MEILI_URL=
MEILI_MASTER_KEY=
GIPHY_API_KEY=
TENOR_API_KEY=
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
