{
  "name": "@veil/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "cap:sync": "next build && cap sync",
    "cap:android": "next build && cap sync android && cap open android",
    "cap:ios": "next build && cap sync ios && cap open ios",
    "android:apk": "next build && cap sync android && cd android && ./gradlew assembleDebug",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "8.0.2",
    "@capacitor-community/contacts": "6.1.1",
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/camera": "6.1.3",
    "@capacitor/core": "6.2.2",
    "@capacitor/geolocation": "6.1.1",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/ios": "6.2.2",
    "@capacitor/keyboard": "6.0.4",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/network": "6.0.4",
    "@capacitor/push-notifications": "6.0.5",
    "@capacitor/share": "6.0.4",
    "@capacitor/splash-screen": "6.0.4",
    "@capacitor/status-bar": "6.0.3",
    "@fontsource-variable/inter": "5.3.0",
    "@veil/secure-screen": "file:./plugins/secure-screen",
    "@veil/ui": "workspace:*",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
